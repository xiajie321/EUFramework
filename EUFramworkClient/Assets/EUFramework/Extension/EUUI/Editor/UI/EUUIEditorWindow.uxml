<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement name="root" class="root">
        
        <!-- 左侧侧边栏 -->
        <ui:VisualElement name="sidebar" class="sidebar">
            <ui:Label text="EUUI 工具" class="sidebar-title" />
            
            <ui:VisualElement name="btn-config-group-container" class="sidebar-button-container">
                <ui:Button name="btn-config-group" class="sidebar-button">
                    <ui:Label text="⚙" class="sidebar-button-icon" />
                    <ui:VisualElement class="sidebar-button-text-container">
                        <ui:Label text="配置管理" class="sidebar-button-title" />
                        <ui:Label text="SO配置、扩展代码生成" class="sidebar-button-subtitle" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
            
            <ui:VisualElement name="btn-workflow-group-container" class="sidebar-button-container">
                <ui:Button name="btn-workflow-group" class="sidebar-button">
                    <ui:Label text="🛠" class="sidebar-button-icon" />
                    <ui:VisualElement class="sidebar-button-text-container">
                        <ui:Label text="UI 制作" class="sidebar-button-title" />
                        <ui:Label text="场景、绑定、导出流程" class="sidebar-button-subtitle" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        
        <!-- 右侧内容区域 -->
        <ui:VisualElement name="content-area" class="content-area">
            <ui:Label name="content-label" text="👈 请选择左侧功能开始使用" class="content-label" />
        </ui:VisualElement>
        
    </ui:VisualElement>
</ui:UXML>
