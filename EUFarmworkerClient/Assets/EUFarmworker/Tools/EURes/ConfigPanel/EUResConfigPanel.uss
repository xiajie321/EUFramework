.root {
    padding: 10px;
    flex-grow: 1;
}

.title {
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 15px;
    padding: 10px;
    background-color: #383838;
    color: #d2d2d2;
    border-radius: 5px;
    -unity-text-align: middle-center;
}

.section-box {
    background-color: #2a2a2a;
    border-radius: 5px;
    padding: 10px;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: #1a1a1a;
}

.section-header {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    color: #a0a0a0;
    border-bottom-width: 1px;
    border-bottom-color: #404040;
    padding-bottom: 5px;
}

.warning-box {
    background-color: #4d1a1a;
    border-color: #ff0000;
    border-width: 1px;
    border-radius: 5px;
    padding: 10px;
    margin-bottom: 10px;
    display: none;
}

.warning-label {
    color: #ffcccc;
    white-space: normal;
}

.create-btn {
    height: 40px;
    font-size: 14px;
    -unity-font-style: bold;
    background-color: #2d5a2d;
    color: #ffffff;
    border-radius: 5px;
    margin-top: 10px;
}

.create-btn:hover {
    background-color: #3d7a3d;
}

.property-field {
    margin-bottom: 5px;
}
